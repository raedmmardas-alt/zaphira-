# Copy this file to .env.amazon.local (in this same server/ directory) and
# fill in real values -- OR just run `npm run setup` from inside server/,
# which imports your existing local credential files automatically and
# prompts you for the Client Secret with a hidden terminal prompt.
#
# .env.amazon.local is gitignored. Never commit real secrets. Never paste
# real secrets into Claude, chat, source code, or the browser.

AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
AMAZON_ADS_PROFILE_ID=
AMAZON_ADS_REGION=NA

# Local backend port. The browser frontend talks to this over
# http://127.0.0.1:<port> only -- never exposed beyond localhost.
AMAZON_BACKEND_PORT=4001
