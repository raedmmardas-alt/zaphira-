# LOCAL DEVELOPMENT ONLY. Copy this file to .env.amazon.local (in this
# same server/ directory) and fill in real values -- OR just run
# `npm run setup` from inside server/, which imports your existing local
# credential files automatically and prompts you for the Client Secret
# with a hidden terminal prompt.
#
# .env.amazon.local is gitignored. Never commit real secrets. Never paste
# real secrets into Claude, chat, source code, or the browser.
#
# In PRODUCTION (Railway), this file does not exist and is never
# deployed -- these same variable names are set directly as Railway
# service environment variables instead (Railway dashboard -> your
# service -> Variables). See server/README.md's "Production deployment
# (Railway)" section.

AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
AMAZON_ADS_REFRESH_TOKEN=
AMAZON_ADS_PROFILE_ID=
AMAZON_ADS_REGION=NA

# Local backend port. The browser frontend talks to this over
# http://127.0.0.1:<port> only -- never exposed beyond localhost. Not used
# in production -- Railway sets PORT itself, which always takes
# precedence (see resolveListenTarget() in src/config.js).
AMAZON_BACKEND_PORT=4001

# Local dev only. In production, set CORS_ALLOWED_ORIGIN as a Railway
# variable instead if the deployed frontend's origin ever needs to change
# from the https://zaphira.raedmirdas.com default (see src/app.js).
# CORS_ALLOWED_ORIGIN=https://zaphira.raedmirdas.com
